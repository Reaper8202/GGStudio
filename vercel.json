{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm run install:game",
  "buildCommand": "npm run build",
  "outputDirectory": "zombie-motorworks/dist",
  "headers": [
    {
      "source": "/assets/:file(.+\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
